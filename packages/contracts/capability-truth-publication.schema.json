{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.entral.example/capability-truth-publication.schema.json",
  "title": "PublicProductTruthProjection",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "schema_version", "projection_id", "environment", "surface", "registry_revision", "generated_at", "expires_at", "claims"],
  "properties": {
    "contract_version": { "const": "1.0.0" },
    "schema_version": { "const": 1 },
    "projection_id": { "type": "string", "format": "uuid" },
    "environment": { "enum": ["DEVELOPMENT", "TEST", "STAGING", "CANARY", "PRODUCTION"] },
    "surface": { "enum": ["WEBSITE", "TUTORIAL", "PRICING", "CHECKOUT", "PROPOSAL", "ONBOARDING", "INTEGRATION_LIST", "MEMBER_APPLICATION", "SALES"] },
    "registry_revision": { "type": "integer", "minimum": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "claim_key", "capability_id", "capability_key", "capability_version", "display_name", "lifecycle_state", "pricing_eligibility", "approved_language", "limitations", "evidence_receipt_ids", "claim_record_version", "capability_record_version"],
        "properties": {
          "claim_id": { "type": "string", "format": "uuid" },
          "claim_key": { "type": "string", "minLength": 3, "maxLength": 160 },
          "capability_id": { "type": "string", "format": "uuid" },
          "capability_key": { "type": "string", "minLength": 3, "maxLength": 160 },
          "capability_version": { "type": "string", "minLength": 5, "maxLength": 80 },
          "display_name": { "type": "string", "minLength": 1, "maxLength": 200 },
          "lifecycle_state": { "const": "SELLABLE" },
          "pricing_eligibility": { "enum": ["INCLUDED", "ADD_ON"] },
          "approved_language": { "type": "string", "minLength": 1, "maxLength": 4000 },
          "limitations": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 2000 } },
          "evidence_receipt_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "format": "uuid" } },
          "claim_record_version": { "type": "integer", "minimum": 1 },
          "capability_record_version": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
