{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://entral.local/contracts/baseline-certification.schema.json",
  "title": "BaselineCertificationManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version", "schema_version", "manifest_id", "phase", "status", "covered_phases",
    "repositories", "deployments", "migrations", "runtime_versions", "requirements", "legacy_isolation",
    "tests", "production_truth", "secure_json_reconciliation", "known_limitations", "rollback_point",
    "certification", "generated_at"
  ],
  "properties": {
    "contract_version": { "const": "1.0.0" },
    "schema_version": { "const": 1 },
    "manifest_id": { "type": "string", "format": "uuid" },
    "phase": { "const": 199 },
    "status": { "enum": ["CANDIDATE_REVIEW", "CERTIFIED", "BLOCKED"] },
    "covered_phases": {
      "type": "array",
      "prefixItems": [
        { "const": 100 }, { "const": 110 }, { "const": 120 }, { "const": 130 }, { "const": 140 },
        { "const": 150 }, { "const": 160 }, { "const": 170 }, { "const": 180 }, { "const": 190 }, { "const": 195 }
      ],
      "items": false,
      "minItems": 11,
      "maxItems": 11
    },
    "repositories": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product", "control_website"],
      "properties": {
        "product": { "$ref": "#/$defs/repository" },
        "control_website": { "$ref": "#/$defs/repository" }
      }
    },
    "deployments": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "$ref": "#/$defs/deployment" } },
    "migrations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/migration" } },
    "runtime_versions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "pnpm", "postgres", "redis"],
      "properties": {
        "node": { "type": "string", "minLength": 1 },
        "pnpm": { "type": "string", "minLength": 1 },
        "postgres": { "type": "string", "minLength": 1 },
        "redis": { "type": "string", "minLength": 1 }
      }
    },
    "requirements": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/requirement" } },
    "legacy_isolation": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/legacy" } },
    "tests": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/test" } },
    "production_truth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release_phase", "canonical_release_id", "phase_gate_id", "authenticated_smoke_sha256", "state_readback_sha256"],
      "properties": {
        "release_phase": { "const": 198 },
        "canonical_release_id": { "type": "string", "format": "uuid" },
        "phase_gate_id": { "type": "string", "format": "uuid" },
        "authenticated_smoke_sha256": { "$ref": "#/$defs/sha256" },
        "state_readback_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "secure_json_reconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "plaintext_rows_found", "plaintext_rows_reencrypted", "receipt_sha256"],
      "properties": {
        "status": { "enum": ["PENDING_DEPLOYMENT", "VERIFIED", "BLOCKED"] },
        "plaintext_rows_found": { "type": ["integer", "null"], "minimum": 0 },
        "plaintext_rows_reencrypted": { "type": ["integer", "null"], "minimum": 0 },
        "receipt_sha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] }
      }
    },
    "known_limitations": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "rollback_point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release_phase", "main_sha", "reference"],
      "properties": {
        "release_phase": { "const": 197 },
        "main_sha": { "$ref": "#/$defs/gitSha" },
        "reference": { "type": "string", "minLength": 1 }
      }
    },
    "certification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["all_mandatory_gates_passed", "phase_200_blocked", "review_checkpoint_id", "review_verdict_commit_sha"],
      "properties": {
        "all_mandatory_gates_passed": { "type": "boolean" },
        "phase_200_blocked": { "type": "boolean" },
        "review_checkpoint_id": { "const": "P199-BASELINE-RECERTIFICATION-REVIEW" },
        "review_verdict_commit_sha": { "anyOf": [{ "$ref": "#/$defs/gitSha" }, { "type": "null" }] }
      }
    },
    "generated_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "gitSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "main_sha"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "main_sha": { "$ref": "#/$defs/gitSha" }
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "provider", "deployment_id", "deployed_commit_sha", "production_url", "status"],
      "properties": {
        "role": { "enum": ["FRONTEND", "API", "WORKER"] },
        "provider": { "enum": ["VERCEL", "RAILWAY"] },
        "deployment_id": { "type": "string", "minLength": 1 },
        "deployed_commit_sha": { "$ref": "#/$defs/gitSha" },
        "production_url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "status": { "const": "READY" }
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "checksum_sha256", "production_readback_sha256"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "status": { "enum": ["APPLIED", "NO_SCHEMA_CHANGE"] },
        "checksum_sha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "production_readback_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path_or_id", "content_sha256", "evidence_type"],
      "properties": {
        "path_or_id": { "type": "string", "minLength": 1 },
        "content_sha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "evidence_type": { "enum": ["SOURCE", "TEST", "DEPLOYMENT", "DATABASE", "PRODUCTION_READBACK", "AUDIT"] }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirement_id", "phase", "state", "summary", "evidence", "limitation"],
      "properties": {
        "requirement_id": { "type": "string", "minLength": 1 },
        "phase": { "enum": [100, 110, 120, 130, 140, 150, 160, 170, 180, 190, 195] },
        "state": { "enum": ["VERIFIED_COMPLETE", "IMPLEMENTED_UNVERIFIED", "PARTIAL", "FAILING", "MISSING", "SUPERSEDED", "CONTRADICTORY", "BLOCKED", "PRODUCTION_UNVERIFIED", "LEGACY_ISOLATED"] },
        "summary": { "type": "string", "minLength": 1 },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } },
        "limitation": { "type": ["string", "null"] }
      }
    },
    "legacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface", "disposition", "production_reachable", "canonical_authority", "evidence"],
      "properties": {
        "surface": { "type": "string", "minLength": 1 },
        "disposition": { "enum": ["DEVELOPMENT_ONLY", "CATALOG_ONLY", "PRESENTATION_ONLY", "SUPERSEDED", "MIGRATION_BOUNDARY"] },
        "production_reachable": { "type": "boolean" },
        "canonical_authority": { "const": false },
        "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "status", "receipt_sha256"],
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "status": { "enum": ["PASSED", "PENDING_REVIEW", "NOT_APPLICABLE"] },
        "receipt_sha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] }
      }
    }
  }
}
