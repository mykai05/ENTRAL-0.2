generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                                  String                               @id @default(cuid())
  name                                String
  email                               String                               @unique
  passwordHash                        String
  role                                String                               @default("USER")
  createdAt                           DateTime                             @default(now())
  updatedAt                           DateTime                             @updatedAt
  lastDashboardSeenAt                 DateTime?
  emailVerifiedAt                     DateTime?
  internalAccess                      Boolean                              @default(false)
  sessionVersion                      Int                                  @default(0)
  deletedAt                           DateTime?                            @db.Timestamptz(6)
  deletionVersion                     Int                                  @default(0)
  AccountDeidentificationReceipt      AccountDeidentificationReceipt[]
  agents                              Agent[]
  agentSchedules                      AgentSchedule[]
  agentTasks                          AgentTask[]
  aiUsageEvents                       AiUsageEvent[]
  auditLogs                           AuditLog[]
  AuthSession                         AuthSession[]
  SessionMutationReceipt              SessionMutationReceipt[]
  automationJobs                      AutomationJob[]
  merchStores                         ClientMerchStore[]
  commandReports                      CommandOSReport[]
  commandSnapshot                     CommandOSSnapshot?
  conversations                       Conversation[]
  emailVerificationTokens             EmailVerificationToken[]
  facelessContentBriefs               FacelessContentBrief[]
  facelessContentPerformanceSnapshots FacelessContentPerformanceSnapshot[]
  financialBudgetReleasePackets       FinancialBudgetReleasePacket[]
  financialLedgerEntries              FinancialLedgerEntry[]
  financialPayoutIntents              FinancialPayoutIntent[]
  financialReconciliationReports      FinancialReconciliationReport[]
  financialScalingBudgetPackets       FinancialScalingBudgetPacket[]
  financialScalingExecutionEntries    FinancialScalingExecutionEntry[]
  financialScalingSpendPackets        FinancialScalingSpendPacket[]
  financialSplitPolicies              FinancialSplitPolicy[]
  growthApprovalsReviewed             GrowthApprovalPacket[]               @relation("GrowthApprovalReviewer")
  growthApprovalPackets               GrowthApprovalPacket[]               @relation("GrowthApprovalOwner")
  IdentityActor                       IdentityActor?
  memberTutorialMutationReceipts      MemberTutorialMutationReceipt[]
  memberTutorialProgress              MemberTutorialProgress[]
  memberWorkspacesPublished           MemberWorkspaceSnapshot[]            @relation("MemberWorkspacePublishedBy")
  MfaFactor                           MfaFactor[]
  passwordResetTokens                 PasswordResetToken[]
  policiesCreated                     Policy[]                             @relation("PolicyCreatedBy")
  portfolioCommandActions             PortfolioCommandAction[]
  revenueAssetControlRecords          RevenueAssetControlRecord[]
  revenueLaunchHandoffPackets         RevenueLaunchHandoffPacket[]
  revenueMoneyArmyBatchRuns           RevenueMoneyArmyBatchRun[]
  revenueOpportunities                RevenueOpportunity[]
  revenuePerformanceSnapshots         RevenuePerformanceSnapshot[]
  revenueSignalConnectorApprovals     RevenueSignalConnectorApproval[]
  revenueSignalImportJobs             RevenueSignalImportJob[]
  shopifyConnections                  ShopifyConnection[]
  shopifyOAuthContinuations           ShopifyOAuthContinuation[]
  tasksAssigned                       Task[]                               @relation("TaskAssignedTo")
  tasksCreated                        Task[]                               @relation("TaskCreatedBy")
  memberships                         TeamMember[]

  @@index([email])
  @@index([emailVerifiedAt])
  @@index([deletedAt])
}

model EmailVerificationToken {
  id                                                            String         @id @default(cuid())
  userId                                                        String
  tokenHash                                                     String         @unique
  expiresAt                                                     DateTime
  consumedAt                                                    DateTime?
  createdAt                                                     DateTime       @default(now())
  flow                                                          String         @default("internal")
  actorId                                                       String?        @db.Uuid
  createdBy                                                     String?        @db.Uuid
  ownedBy                                                       String?        @db.Uuid
  IdentityActor_EmailVerificationToken_actorIdToIdentityActor   IdentityActor? @relation("EmailVerificationToken_actorIdToIdentityActor", fields: [actorId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  IdentityActor_EmailVerificationToken_createdByToIdentityActor IdentityActor? @relation("EmailVerificationToken_createdByToIdentityActor", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  IdentityActor_EmailVerificationToken_ownedByToIdentityActor   IdentityActor? @relation("EmailVerificationToken_ownedByToIdentityActor", fields: [ownedBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  user                                                          User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt])
  @@index([expiresAt])
}

model PasswordResetToken {
  id                                                        String         @id @default(cuid())
  userId                                                    String
  tokenHash                                                 String         @unique
  expiresAt                                                 DateTime
  consumedAt                                                DateTime?
  createdAt                                                 DateTime       @default(now())
  flow                                                      String         @default("internal")
  actorId                                                   String?        @db.Uuid
  createdBy                                                 String?        @db.Uuid
  ownedBy                                                   String?        @db.Uuid
  IdentityActor_PasswordResetToken_actorIdToIdentityActor   IdentityActor? @relation("PasswordResetToken_actorIdToIdentityActor", fields: [actorId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  IdentityActor_PasswordResetToken_createdByToIdentityActor IdentityActor? @relation("PasswordResetToken_createdByToIdentityActor", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  IdentityActor_PasswordResetToken_ownedByToIdentityActor   IdentityActor? @relation("PasswordResetToken_ownedByToIdentityActor", fields: [ownedBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  user                                                      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt])
  @@index([expiresAt])
}

