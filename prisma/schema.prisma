  TenantBoundary                                                                                  TenantBoundary?                      @relation(fields: [tenantId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: NoAction, map: "ClientMerchStore_phase202_tenant_org_fkey")
  user                                                                                            User                                 @relation(fields: [userId], references: [id], onDelete: Cascade)
